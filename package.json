{
  "name": "ai-symphony",
  "version": "0.1.0",
  "description": "Symphony: an orchestration service that continuously reads work from a configured issue tracker and runs coding agent sessions per issue, per SPEC.md.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "symphony": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "js-yaml": "^4.1.0",
    "liquidjs": "^10.16.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
}
